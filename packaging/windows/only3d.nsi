; The Windows installer: per user (no administrator rights), into
; %LOCALAPPDATA%\Programs\only3d, with Start menu and desktop shortcuts that open the window.
; Built by CI: makensis /DVERSION=0.1.0 /DSRC=<folder with the exes> /DOUT=<setup.exe> only3d.nsi
Unicode true
!include "MUI2.nsh"
!include "WinMessages.nsh"

!ifndef VERSION
  !define VERSION "0.0.0"
!endif
!define APP "only3d"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP}"
; The user's PATH, edited in the registry by PowerShell: NSIS's own strings stop at 1024
; characters and would cut a long PATH short. %VARS% in it stay as they are. The folder comes in
; through ONLY3D_DIR so no quote in it can break the command.
!define PS '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command'
!define READ_PATH "$$d = $$env:ONLY3D_DIR; $$p = [string](Get-Item HKCU:\Environment).GetValue('Path', '', 'DoNotExpandEnvironmentNames')"
!define WRITE_PATH "New-ItemProperty -Path HKCU:\Environment -Name Path -Value $$v -PropertyType ExpandString -Force | Out-Null"

Name "${APP}"
OutFile "${OUT}"
InstallDir "$LOCALAPPDATA\Programs\${APP}"
InstallDirRegKey HKCU "Software\${APP}" "InstallDir"
RequestExecutionLevel user
SetCompressor /SOLID lzma

!define MUI_ICON "..\icons\only3d.ico"
!define MUI_UNICON "..\icons\only3d.ico"
!define MUI_FINISHPAGE_RUN "$INSTDIR\only3d-app.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Open only3d"
; what the installer changes and what only3d sends over the network (docs/privacy.md)
!define MUI_WELCOMEPAGE_TEXT "This installs only3d for you only, with no administrator rights, in your user folder (AppData\Local\Programs\only3d).$\r$\n$\r$\nIt adds Start menu and desktop shortcuts, and adds its folder to your PATH so the only3d command works in new terminals. Uninstalling removes all of them.$\r$\n$\r$\nonly3d has no telemetry. It connects to the printers you add, and once a day to GitHub to check for a newer version (Preferences turns that off). Nothing about you or your projects is sent. Details: github.com/onatyap/only3d/blob/main/docs/privacy.md"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "..\..\LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

VIProductVersion "${VERSION}.0"
VIAddVersionKey "ProductName" "${APP}"
VIAddVersionKey "FileDescription" "${APP} installer"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "LegalCopyright" "AGPL-3.0-or-later"

Section "only3d"
  SetOutPath "$INSTDIR"
  File "${SRC}\only3d.exe"
  File "${SRC}\only3d-app.exe"
  File "..\icons\only3d.ico"
  File "..\..\LICENSE"
  ; generated by packaging/third_party_notices.py before packaging
  File "${SRC}\..\THIRD-PARTY-NOTICES.txt"
  WriteUninstaller "$INSTDIR\uninstall.exe"
  CreateShortcut "$SMPROGRAMS\${APP}.lnk" "$INSTDIR\only3d-app.exe" "" "$INSTDIR\only3d.ico"
  CreateShortcut "$DESKTOP\${APP}.lnk" "$INSTDIR\only3d-app.exe" "" "$INSTDIR\only3d.ico"
  WriteRegStr HKCU "Software\${APP}" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "${APP}"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\only3d.ico"
  WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "only3d"
  WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1
  ; `only3d` in new terminals: `only3d mcp install claude-code`, and agents' shell calls
  System::Call 'Kernel32::SetEnvironmentVariable(t "ONLY3D_DIR", t "$INSTDIR")'
  nsExec::ExecToLog `${PS} "${READ_PATH}; if (($$p -split ';') -notcontains $$d) { $$v = ($$p.TrimEnd(';') + ';' + $$d).TrimStart(';'); ${WRITE_PATH} }"`
  SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
SectionEnd

Section "Uninstall"
  Delete "$SMPROGRAMS\${APP}.lnk"
  Delete "$DESKTOP\${APP}.lnk"
  Delete "$INSTDIR\only3d.exe"
  Delete "$INSTDIR\only3d-app.exe"
  Delete "$INSTDIR\only3d.ico"
  Delete "$INSTDIR\LICENSE"
  Delete "$INSTDIR\THIRD-PARTY-NOTICES.txt"
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "${UNINST_KEY}"
  DeleteRegKey HKCU "Software\${APP}"
  System::Call 'Kernel32::SetEnvironmentVariable(t "ONLY3D_DIR", t "$INSTDIR")'
  nsExec::ExecToLog `${PS} "${READ_PATH}; $$v = (($$p -split ';') | Where-Object { $$_ -and $$_ -ne $$d }) -join ';'; if ($$v -ne $$p) { ${WRITE_PATH} }"`
  SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
SectionEnd
