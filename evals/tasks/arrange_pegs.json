    ["add_object", {"id": "peg_a", "shape": {"type": "box", "size": [20, 20, 10]}, "position": [60, 60]}],
    ["add_object", {"id": "peg_b", "shape": {"type": "box", "size": [25, 20, 10]}, "position": [260, 70]}],
    ["add_object", {"id": "peg_c", "shape": {"type": "box", "size": [15, 20, 10]}, "position": [300, 140]}]
