      ["peg_a", "min_x", "base", "min_x", 0], ["peg_b", "min_x", "peg_a", "max_x", 0], ["peg_c", "min_x", "peg_b", "max_x", 0],
      ["base", "min_x", "base", "min_x", 0]
    ]},
    {"checks_clean": true}
  ]
}
